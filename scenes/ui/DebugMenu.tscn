[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/DebugMenu.gd" id="1_debug"]

[node name="DebugMenu" type="CanvasLayer"]
script = ExtResource("1_debug")
layer = 100

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 11
anchor_left = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -330.0
offset_top = 10.0
offset_right = -10.0
offset_bottom = -10.0
visible = false

[node name="ScrollContainer" type="ScrollContainer" parent="Panel"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="VBox" type="VBoxContainer" parent="Panel/ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 5

[node name="Title" type="Label" parent="Panel/ScrollContainer/VBox"]
text = "▶ DEBUG MENU (F1)"
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(1, 0.8, 0.2, 1)

[node name="SeedRow" type="HBoxContainer" parent="Panel/ScrollContainer/VBox"]

[node name="SeedLabel" type="Label" parent="Panel/ScrollContainer/VBox/SeedRow"]
text = "Seed:"
custom_minimum_size = Vector2(50, 0)
theme_override_font_sizes/font_size = 12

[node name="SeedInput" type="LineEdit" parent="Panel/ScrollContainer/VBox/SeedRow"]
size_flags_horizontal = 3
placeholder_text = "random"
theme_override_font_sizes/font_size = 12

[node name="RegenBtn" type="Button" parent="Panel/ScrollContainer/VBox"]
text = "🗺 Regen Dungeon"
theme_override_font_sizes/font_size = 12

[node name="SepRat" type="HSeparator" parent="Panel/ScrollContainer/VBox"]

[node name="RatPhysicsHeader" type="Label" parent="Panel/ScrollContainer/VBox"]
text = "🐀 JOLT PHYSICS RATS"
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.4, 0.9, 1.0, 1)

[node name="SpawnPhysicsRatBtn" type="Button" parent="Panel/ScrollContainer/VBox"]
text = "🐁 Spawn Physics Rat"
theme_override_font_sizes/font_size = 12

[node name="SpawnSwarmBtn" type="Button" parent="Panel/ScrollContainer/VBox"]
text = "🐀 Spawn Rat Swarm (x10)"
theme_override_font_sizes/font_size = 12

[node name="ShockwaveBtn" type="Button" parent="Panel/ScrollContainer/VBox"]
text = "💥 Shockwave Blast"
theme_override_font_sizes/font_size = 12

[node name="SpawnRatCreatureBtn" type="Button" parent="Panel/ScrollContainer/VBox"]
text = "🐾 Spawn Rat (AI Creature)"
theme_override_font_sizes/font_size = 12

[node name="ClearRatsBtn" type="Button" parent="Panel/ScrollContainer/VBox"]
text = "🧹 Clear Physics Rats"
theme_override_font_sizes/font_size = 12

[node name="Sep1" type="HSeparator" parent="Panel/ScrollContainer/VBox"]

[node name="SpawnDeer" type="Button" parent="Panel/ScrollContainer/VBox"]
text = "Spawn Deer"
theme_override_font_sizes/font_size = 12

[node name="SpawnBoar" type="Button" parent="Panel/ScrollContainer/VBox"]
text = "Spawn Boar"
theme_override_font_sizes/font_size = 12

[node name="SpawnWolf" type="Button" parent="Panel/ScrollContainer/VBox"]
text = "Spawn Wolf"
theme_override_font_sizes/font_size = 12

[node name="SpawnBear" type="Button" parent="Panel/ScrollContainer/VBox"]
text = "Spawn Bear"
theme_override_font_sizes/font_size = 12

[node name="Sep2" type="HSeparator" parent="Panel/ScrollContainer/VBox"]

[node name="GiveResBtn" type="Button" parent="Panel/ScrollContainer/VBox"]
text = "💰 Give All Resources"
theme_override_font_sizes/font_size = 12

[node name="CompleteQuestBtn" type="Button" parent="Panel/ScrollContainer/VBox"]
text = "✅ Complete Quest"
theme_override_font_sizes/font_size = 12

[node name="TeleportExtBtn" type="Button" parent="Panel/ScrollContainer/VBox"]
text = "📍 Teleport → Extraction"
theme_override_font_sizes/font_size = 12

[node name="ToggleAIBtn" type="Button" parent="Panel/ScrollContainer/VBox"]
text = "🤖 Toggle AI"
theme_override_font_sizes/font_size = 12

[node name="Sep3" type="HSeparator" parent="Panel/ScrollContainer/VBox"]

[node name="MenuBtn" type="Button" parent="Panel/ScrollContainer/VBox"]
text = "← Main Menu"
theme_override_font_sizes/font_size = 12

[node name="StatusLabel" type="Label" parent="Panel/ScrollContainer/VBox"]
text = ""
autowrap_mode = 3
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.7, 1, 0.7, 1)

[connection signal="pressed" from="Panel/ScrollContainer/VBox/RegenBtn" to="." method="_on_regen_dungeon"]
[connection signal="pressed" from="Panel/ScrollContainer/VBox/SpawnPhysicsRatBtn" to="." method="_on_spawn_rat_physics"]
[connection signal="pressed" from="Panel/ScrollContainer/VBox/SpawnSwarmBtn" to="." method="_on_spawn_rat_swarm"]
[connection signal="pressed" from="Panel/ScrollContainer/VBox/ShockwaveBtn" to="." method="_on_shockwave_blast"]
[connection signal="pressed" from="Panel/ScrollContainer/VBox/SpawnRatCreatureBtn" to="." method="_on_spawn_rat_creature"]
[connection signal="pressed" from="Panel/ScrollContainer/VBox/ClearRatsBtn" to="." method="_on_clear_rats"]
[connection signal="pressed" from="Panel/ScrollContainer/VBox/SpawnDeer" to="." method="_on_spawn_deer"]
[connection signal="pressed" from="Panel/ScrollContainer/VBox/SpawnBoar" to="." method="_on_spawn_boar"]
[connection signal="pressed" from="Panel/ScrollContainer/VBox/SpawnWolf" to="." method="_on_spawn_wolf"]
[connection signal="pressed" from="Panel/ScrollContainer/VBox/SpawnBear" to="." method="_on_spawn_bear"]
[connection signal="pressed" from="Panel/ScrollContainer/VBox/GiveResBtn" to="." method="_on_give_all_resources"]
[connection signal="pressed" from="Panel/ScrollContainer/VBox/CompleteQuestBtn" to="." method="_on_complete_quest"]
[connection signal="pressed" from="Panel/ScrollContainer/VBox/TeleportExtBtn" to="." method="_on_teleport_extraction"]
[connection signal="pressed" from="Panel/ScrollContainer/VBox/ToggleAIBtn" to="." method="_on_toggle_ai"]
[connection signal="pressed" from="Panel/ScrollContainer/VBox/MenuBtn" to="." method="_on_return_to_menu"]
